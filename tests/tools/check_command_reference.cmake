# Checks (or with -DUPDATE=ON rewrites) the generated table in docs/console-commands.md against
# the command registry of the built application.
#   cmake -DEXE=<openmine-desktop> -DDOC=<docs/console-commands.md> -DOUT=<scratch file> [-DUPDATE=ON] -P check_command_reference.cmake
execute_process(COMMAND "${EXE}" --command-reference "${OUT}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "openmine-desktop --command-reference failed (${rc})")
endif()
file(READ "${OUT}" generated)
file(READ "${DOC}" doc)
set(begin "<!-- BEGIN GENERATED: openmine-desktop --command-reference -->\n")
set(end "<!-- END GENERATED -->")
string(FIND "${doc}" "${begin}" b)
string(FIND "${doc}" "${end}" e)
if(b EQUAL -1 OR e EQUAL -1)
    message(FATAL_ERROR "${DOC} has no generated section markers")
endif()
string(LENGTH "${begin}" bl)
math(EXPR start "${b} + ${bl}")
math(EXPR len "${e} - ${start}")
string(SUBSTRING "${doc}" ${start} ${len} current)
if(current STREQUAL generated)
    message(STATUS "console reference is up to date")
elseif(UPDATE)
    string(SUBSTRING "${doc}" 0 ${start} head)
    string(SUBSTRING "${doc}" ${e} -1 tail)
    file(WRITE "${DOC}" "${head}${generated}${tail}")
    message(STATUS "updated ${DOC}")
else()
    message(FATAL_ERROR "docs/console-commands.md is out of date: run\n  cmake -DEXE=${EXE} -DDOC=${DOC} -DOUT=${OUT} -DUPDATE=ON -P ${CMAKE_CURRENT_LIST_FILE}")
endif()
