{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "openmine-suite",
  "version-string": "0.4.0",
  "description": "Open-source integrated mine survey, design and scheduling",
  "license": "Apache-2.0",
  "dependencies": [
    "sqlite3",
    "eigen3",
    "nlohmann-json",
    "nanoflann",
    "zlib",
    "libxlsxwriter",
    "clipper2",
    { "name": "qtbase", "default-features": false, "features": ["widgets", "opengl", "gui", "png", "freetype"] },
    "qtsvg",
    { "name": "vtk", "default-features": false, "features": ["opengl"] },
    { "name": "hdf5", "default-features": false, "features": ["zlib"],
      "$comment": "required by VTK; listed here only to drop hdf5's default szip feature (libaec, whose source host rate-limits downloads)" }
  ],
  "default-features": ["solids", "pointclouds", "gis", "repository", "tests"],
  "features": {
    "solids": {
      "description": "Open CASCADE solid modelling, STEP/IGES",
      "dependencies": [{ "name": "opencascade", "default-features": false }]
    },
    "pointclouds": {
      "description": "PDAL point-cloud I/O (LAS/LAZ/E57/PLY), SMRF and Poisson (without the HDF, Draco and pgpointcloud plugins, which the application does not use)",
      "dependencies": [{ "name": "pdal", "default-features": false, "features": ["e57"] }]
    },
    "gis": {
      "description": "PROJ coordinate transformations and GDAL raster/vector exchange (no GPL drivers; Expat for the KML, GPX and GML readers)",
      "dependencies": ["proj", { "name": "gdal", "default-features": false, "features": ["geos", "sqlite3", "expat"] }]
    },
    "repository": {
      "description": "PostgreSQL/PostGIS shared repository client",
      "dependencies": ["libpq"]
    },
    "python": {
      "description": "pybind11 for the 'openmine' Python extension (OPENMINE_BUILD_PYTHON)",
      "dependencies": ["pybind11"]
    },
    "tests": {
      "description": "GoogleTest",
      "dependencies": ["gtest"]
    }
  }
}
